{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nitrous-0xide.github.io/cleardesk-command/status.schema.json",
  "title": "ClearDesk Command status",
  "type": "object",
  "required": ["updated_at", "channels", "offer", "pay", "closes", "last_action", "blockers", "feed"],
  "properties": {
    "updated_at": { "type": "string", "description": "ISO-8601 timestamp of last status.json edit" },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "description": "e.g. live | pending | blocked" },
          "url": { "type": "string" }
        }
      }
    },
    "offer": {
      "type": "object",
      "required": ["live", "name", "price_usd", "slots_open"],
      "properties": {
        "live": { "type": "boolean" },
        "name": { "type": "string" },
        "price_usd": { "type": "number" },
        "slots_open": { "type": "integer" }
      }
    },
    "pay": {
      "type": "object",
      "required": ["ready", "method"],
      "properties": {
        "ready": { "type": "boolean" },
        "method": { "type": "string", "description": "Public-facing label only — never put PayPal username here" }
      }
    },
    "closes": {
      "type": "object",
      "required": ["earned_usd", "target_usd", "closed_slots", "goal_slots"],
      "properties": {
        "earned_usd": { "type": "number" },
        "target_usd": { "type": "number" },
        "closed_slots": { "type": "integer" },
        "goal_slots": { "type": "integer" }
      }
    },
    "last_action": {
      "type": "object",
      "required": ["at", "text"],
      "properties": {
        "at": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "feed": {
      "type": "array",
      "description": "Newest first. Cap at ~20 entries.",
      "items": {
        "type": "object",
        "required": ["at", "by", "text"],
        "properties": {
          "at": { "type": "string" },
          "by": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
